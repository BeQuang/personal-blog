    "storage:test": "node --conditions=react-server --import tsx scripts/test-stage16-storage.ts",
    "storage:test:database": "node --conditions=react-server --import tsx scripts/test-stage16-database.ts",
    "storage:test:security": "node --conditions=react-server --import tsx scripts/test-stage16-security.ts",
    "video:test": "node --conditions=react-server --import tsx scripts/test-stage17-video.ts",
    "db:studio": "drizzle-kit studio",
    "auth:bootstrap": "node scripts/bootstrap-admin.mjs",
