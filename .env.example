NEXT_PUBLIC_SITE_URL=http://localhost:3000
USE_DATABASE_CONTENT=false

# Runtime application connection (Supavisor Transaction Pooler on serverless).
DATABASE_URL=

# Migration connection (Direct, or Supavisor Session Pooler port 5432 when IPv6 is unavailable).
DIRECT_DATABASE_URL=

NEXT_PUBLIC_SUPABASE_URL=

# Preferred for new Supabase projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy fallback: leave empty when using the preferred keys above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# One-time initial Admin bootstrap. Keep disabled in shared/production examples.
# When enabled, npm run dev/start creates this account only if Auth has zero users.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=buithanhquangqn22@gmail.com
BOOTSTRAP_ADMIN_DISPLAY_NAME=BeQuang
BOOTSTRAP_ADMIN_PASSWORD=
