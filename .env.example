# Canonical origin. Use the real HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public content source: false = mock fixtures; true = PostgreSQL.
# Recommended: false for fixture-only development, true for staging/production.
# Only the exact lowercase values "true" and "false" are accepted.
USE_DATABASE_CONTENT=false

# Internal analytics master switch.
# true = show consent UI and collect only after consent; false = disable client and server analytics.
# Recommended: false for local/shared-preview unless testing analytics; true in production only
# after privacy/consent review and the analytics retention scheduler are configured.
# Current implementation disables analytics only for the exact lowercase value "false".
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# Runtime application connection (Supavisor Transaction Pooler on serverless).
DATABASE_URL=
# Optional: defaults to 5 in development and 1 in production; range 1-10.
DATABASE_POOL_MAX=1

# Migration connection (Direct, or Supavisor Session Pooler port 5432 when IPv6 is unavailable).
DIRECT_DATABASE_URL=

NEXT_PUBLIC_SUPABASE_URL=

# Preferred for new Supabase projects.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Legacy fallback: leave empty when using the preferred keys above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# One-time initial Admin bootstrap. Exact "true" enables it; every other value disables it.
# Keep false after the first Admin exists and in every shared/normal production runtime.
# When enabled, npm run dev/start creates this account only if Auth has zero users.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=buithanhquangqn22@gmail.com
BOOTSTRAP_ADMIN_DISPLAY_NAME=BeQuang
BOOTSTRAP_ADMIN_PASSWORD=

# Cloudflare R2 storage for media assets. Leave empty to disable.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
MEDIA_ORPHAN_MIN_AGE_HOURS=24

# Mux Video. All values are server-only and must never use NEXT_PUBLIC_.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# Cloudflare Turnstile CAPTCHA service. Leave empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email service. Leave empty to disable.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=

# Upstash Redis. Required in production; development falls back to in-memory limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional overrides for `npm run auth:test`; defaults are shown.
AUTH_TEST_PROTECTED_PATH=/admin/settings
AUTH_TEST_PROTECTED_STATUS=200
